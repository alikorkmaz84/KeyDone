<Application x:Class="KeyDone.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Tıklama alanları büyük, aralıklar rahat; renkler Windows temasından ve yüksek karşıtlık modundan gelir. -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,10,0,3" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <!--
            Liste öğesinin ekran okuyucudaki adı: sütunların okunacak hali (Spoken).
            Listeler düz liste (ListBox) olduğu için ekran okuyucu "satır" demez, liste öğesi olarak okur.
        -->
        <Style x:Key="SpokenItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Spoken, Mode=OneWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <!-- Listelerin üstündeki görsel sütun başlıkları. -->
        <Style x:Key="ColumnHeader" TargetType="Grid">
            <Setter Property="Margin" Value="6,0,6,3" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        </Style>
        <!-- Düz metin listeleri için: öğenin adı metnin kendisidir. -->
        <Style x:Key="SpokenText" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Mode=OneWay}" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Style>
    </Application.Resources>
</Application>
