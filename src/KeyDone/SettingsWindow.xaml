<Window x:Class="KeyDone.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar – KeyDone" Width="520" SizeToContent="Height"
        FontSize="15" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <Label Content="_Hareketsiz kalınca kasayı kilitle:" Target="{Binding ElementName=AutoLockBox}" Padding="0,0,0,3" />
        <ComboBox x:Name="AutoLockBox" AutomationProperties.Name="Hareketsiz kalınca kasayı kilitle" />
        <Label Content="_Kopyalanan bilgiyi panodan sil:" Target="{Binding ElementName=ClipboardBox}" />
        <ComboBox x:Name="ClipboardBox" AutomationProperties.Name="Kopyalanan bilgiyi panodan sil" />
        <CheckBox x:Name="PhoneticBox" Content="Harf harf okurken kod _kelimelerini de söyle (A, Adana gibi)" Margin="0,14,0,0" />
        <WrapPanel Margin="0,16,0,0">
            <Button Content="_Tamam" IsDefault="True" Click="Ok_Click" />
            <Button Content="Vazgeç" IsCancel="True" />
        </WrapPanel>
    </StackPanel>
</Window>
