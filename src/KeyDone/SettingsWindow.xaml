<Window x:Class="KeyDone.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar – KeyDone" Width="660" Height="560" MinWidth="460" MinHeight="420"
        FontSize="15" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Ctrl+Tab ve Ctrl+Shift+Tab sekmeler arasında geçer; Tab sekmenin içinde gezer. -->
    <Grid Margin="16" KeyboardNavigation.DirectionalNavigation="None">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0" AutomationProperties.Name="Ayar sekmeleri">
            <TabItem Header="_Genel">
                <StackPanel Margin="12">
                    <Label Content="_Hareketsiz kalınca kasayı kilitle:" Target="{Binding ElementName=AutoLockBox}" Padding="0,0,0,3" />
                    <ComboBox x:Name="AutoLockBox" AutomationProperties.Name="Hareketsiz kalınca kasayı kilitle" />
                    <Label Content="Kopyalanan bilgiyi _panodan sil:" Target="{Binding ElementName=ClipboardBox}" />
                    <ComboBox x:Name="ClipboardBox" AutomationProperties.Name="Kopyalanan bilgiyi panodan sil" />
                    <CheckBox x:Name="PhoneticBox" Content="Harf harf okurken _il adlarını da söyle (A, Adana gibi)" Margin="0,14,0,0" />
                </StackPanel>
            </TabItem>

            <TabItem Header="_Sesler">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="SoundsBox" Grid.Row="0" Content="Sesleri _çal" Margin="0" />
                    <StackPanel Grid.Row="1">
                        <Label Content="Ses _düzeyi:" Target="{Binding ElementName=VolumeBox}" />
                        <ComboBox x:Name="VolumeBox" AutomationProperties.Name="Ses düzeyi" Width="200" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Label Grid.Row="2" Content="Ses _listesi:" Target="{Binding ElementName=SoundList}" />
                    <ListView x:Name="SoundList" Grid.Row="3" AutomationProperties.Name="Ses listesi"
                              AutomationProperties.HelpText="Enter seçili sesi çalar."
                              SelectionMode="Single" ItemContainerStyle="{StaticResource SpokenItem}"
                              PreviewKeyDown="SoundList_PreviewKeyDown">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="Olay" Width="300" DisplayMemberBinding="{Binding Title}" />
                                <GridViewColumn Header="Ses" Width="200" DisplayMemberBinding="{Binding Source}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="SoundHint" Grid.Row="4" Style="{StaticResource Hint}" />
                    <WrapPanel Grid.Row="5" Margin="0,10,0,0">
                        <Button Content="Di_nle" Click="Listen_Click" />
                        <Button Content="Ses klasörünü _aç" Click="OpenSoundFolder_Click" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="_Kısayollar">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="Kısa_yollar:" Target="{Binding ElementName=ShortcutList}" Padding="0,0,0,3" />
                    <ListView x:Name="ShortcutList" Grid.Row="1" AutomationProperties.Name="Kısayol listesi"
                              AutomationProperties.HelpText="Enter kısayolu değiştirir, Delete kaldırır."
                              SelectionMode="Single" ItemContainerStyle="{StaticResource SpokenItem}"
                              PreviewKeyDown="ShortcutList_PreviewKeyDown">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="İşlem" Width="340" DisplayMemberBinding="{Binding Title}" />
                                <GridViewColumn Header="Kısayol" Width="180" DisplayMemberBinding="{Binding Keys}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Content="Değiş_tir..." Click="Change_Click" />
                        <Button Content="Kaldı_r" Click="Remove_Click" />
                        <Button Content="_Varsayılana döndür" Click="Reset_Click" />
                        <Button Content="Tü_münü varsayılana döndür" Click="ResetAll_Click" />
                    </WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <WrapPanel Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button Content="Tamam" IsDefault="True" Click="Ok_Click" />
            <Button Content="Vazgeç" IsCancel="True" Margin="0,0,0,8" />
        </WrapPanel>
    </Grid>
</Window>
