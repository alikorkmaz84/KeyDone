<Window x:Class="KeyDone.ListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="520" MinWidth="320" MinHeight="260"
        FontSize="15" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label x:Name="CaptionLabel" Grid.Row="0" Target="{Binding ElementName=Items}" Padding="0,0,0,3" />
        <ListBox x:Name="Items" Grid.Row="1" ItemContainerStyle="{StaticResource SpokenItem}" />
        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="_Kapat" IsCancel="True" />
        </WrapPanel>
    </Grid>
</Window>
