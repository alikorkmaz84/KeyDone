<Window x:Class="KeyDone.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIN belirle – KeyDone" Width="520" SizeToContent="Height"
        FontSize="15" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16" KeyboardNavigation.DirectionalNavigation="None">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap"
                   Text="Kasa kilitlendiğinde, program kapanana kadar bu 4 haneli PIN ile açabilirsiniz. PIN 3 kez yanlış girilirse ana şifre istenir. 1234 ya da 0000 gibi kolay tahmin edilen PIN'ler kabul edilmez." />
        <Label Content="_PIN (4 rakam):" Target="{Binding ElementName=PinBox}" />
        <PasswordBox x:Name="PinBox" MaxLength="4" Width="140" HorizontalAlignment="Left" AutomationProperties.Name="PIN (4 rakam)" />
        <Label Content="PIN (_tekrar):" Target="{Binding ElementName=RepeatBox}" />
        <PasswordBox x:Name="RepeatBox" MaxLength="4" Width="140" HorizontalAlignment="Left" AutomationProperties.Name="PIN (tekrar)" />
        <WrapPanel Margin="0,16,0,0">
            <Button Content="Tamam" IsDefault="True" Click="Ok_Click" />
            <Button Content="Vazgeç" IsCancel="True" />
        </WrapPanel>
    </StackPanel>
</Window>
