<Window x:Class="KeyDone.EntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kayıt – KeyDone" Width="640" Height="640" MinWidth="420" MinHeight="360"
        FontSize="15" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Sekme sırası: tür, alanlar, sonra düğmeler. -->
    <Grid Margin="16" KeyboardNavigation.DirectionalNavigation="None">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="KindPanel" Grid.Row="0">
            <Label Content="Kayıt _türü:" Target="{Binding ElementName=KindBox}" Padding="0,0,0,3" />
            <ComboBox x:Name="KindBox" AutomationProperties.Name="Kayıt türü" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,4,0,0">
            <StackPanel x:Name="FormPanel" Margin="0,0,12,0" />
        </ScrollViewer>
        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="_Kaydet" IsDefault="True" Click="Save_Click" AutomationProperties.HelpText="Kısayol: Control S" />
            <Button Content="Vazgeç" IsCancel="True" />
        </WrapPanel>
    </Grid>
</Window>
