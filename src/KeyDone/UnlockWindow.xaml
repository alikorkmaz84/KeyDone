<Window x:Class="KeyDone.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kasayı aç – KeyDone" Width="560" SizeToContent="Height"
        FontSize="15" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16" KeyboardNavigation.DirectionalNavigation="None">
        <TextBlock x:Name="InfoText" TextWrapping="Wrap" Margin="0,0,0,4" />

        <!-- PIN ile hızlı açma (yalnızca kasa bu çalışmada açılmış ve sonra kilitlenmişse) -->
        <StackPanel x:Name="PinPanel" Visibility="Collapsed">
            <Label Content="_PIN (4 rakam):" Target="{Binding ElementName=PinBox}" />
            <PasswordBox x:Name="PinBox" MaxLength="4" Width="140" HorizontalAlignment="Left"
                         AutomationProperties.Name="PIN (4 rakam)" PasswordChanged="PinBox_PasswordChanged" />
        </StackPanel>

        <!-- Ana şifre -->
        <StackPanel x:Name="PasswordPanel">
            <Label x:Name="PasswordLabel" Content="_Ana şifre:" />
            <ContentControl x:Name="PasswordHost" Focusable="False" />
        </StackPanel>

        <WrapPanel Margin="0,16,0,0">
            <Button x:Name="OpenButton" Content="Kasayı aç" IsDefault="True" Click="Open_Click" />
            <Button x:Name="ModeButton" Content="Ana _şifreyle aç" Click="Mode_Click" Visibility="Collapsed" />
            <Button x:Name="OtherButton" Content="_Başka bir kasa aç..." Click="Other_Click" />
            <Button Content="_Yeni kasa oluştur..." Click="New_Click" />
            <Button Content="_Kapat" IsCancel="True" />
        </WrapPanel>
    </StackPanel>
</Window>
