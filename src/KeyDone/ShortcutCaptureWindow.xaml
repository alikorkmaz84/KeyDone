<Window x:Class="KeyDone.ShortcutCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kısayol ata – KeyDone" Width="520" SizeToContent="Height"
        FontSize="15" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16" KeyboardNavigation.DirectionalNavigation="None">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" />
        <Label Content="Yeni kısayol:" Target="{Binding ElementName=KeyBox}" />
        <TextBox x:Name="KeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="True" AutomationProperties.Name="Yeni kısayol"
                 PreviewKeyDown="KeyBox_PreviewKeyDown" />
        <TextBlock x:Name="ProblemText" Style="{StaticResource Hint}" />
        <WrapPanel Margin="0,16,0,0">
            <Button Content="Tamam" IsDefault="True" Click="Ok_Click" />
            <Button Content="Vazgeç" IsCancel="True" />
        </WrapPanel>
    </StackPanel>
</Window>
