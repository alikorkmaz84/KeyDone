<Window x:Class="KeyDone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeyDone"
        Title="KeyDone" Width="1150" Height="720" MinWidth="720" MinHeight="460"
        FontSize="15" WindowStartupLocation="CenterScreen">
    <!--
        Klavye düzeni:
        - Menü çubuğuna yalnızca Alt ya da F10 ile ulaşılır; Tab ile menüye gidilmez.
        - Tab yalnızca dört yerde durur: arama kutusu, kategoriler, kayıt listesi, alan listesi.
        - Kategoriler solda alt alta durur; ok tuşları kategori değiştirir; Ctrl+Tab her yerden sonraki kategoriye geçer.
        - F6 kayıt listesi ile alan listesi arasında geçer.
    -->
    <DockPanel KeyboardNavigation.DirectionalNavigation="None">
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" FontSize="15"
              KeyboardNavigation.TabNavigation="None" KeyboardNavigation.ControlTabNavigation="None" />

        <StatusBar DockPanel.Dock="Bottom" Focusable="False">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Kasa kilitli." />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Arama -->
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,0,0,8">
                <Label Content="A_ra:" Target="{Binding ElementName=SearchBox}" Padding="0,0,0,3" />
                <TextBox x:Name="SearchBox" AutomationProperties.Name="Ara"
                         AutomationProperties.HelpText="Yazdıkça kayıt listesi süzülür. Aşağı ok listeye geçer."
                         TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
            </StackPanel>

            <!-- Kategoriler: solda, alt alta; hepsi her zaman görünür. Sekmelerin içeriği yoktur, yalnızca listeyi süzer. -->
            <DockPanel Grid.Row="1" Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Kategoriler:" FontWeight="SemiBold" Margin="0,0,0,3" />
                <TabControl x:Name="CategoryTabs" TabStripPlacement="Left" Padding="0" BorderThickness="0"
                            VerticalAlignment="Top" MinWidth="190"
                            AutomationProperties.Name="Kategoriler"
                            AutomationProperties.HelpText="Ok tuşları kategori değiştirir. Ctrl+Tab her yerden sonraki kategoriye geçer."
                            SelectionChanged="CategoryTabs_SelectionChanged" PreviewKeyDown="CategoryTabs_PreviewKeyDown" />
            </DockPanel>

            <!-- Kayıtlar -->
            <DockPanel Grid.Row="1" Grid.Column="2">
                <Label DockPanel.Dock="Top" Content="Kayıt _listesi:" Target="{Binding ElementName=EntryList}" Padding="0,0,0,3" />
                <!--
                    Düz liste: ekran okuyucu öğeleri "satır" değil liste öğesi olarak okur.
                    Sütunlar yalnızca görseldir; başlık satırı ekran okuyucudan gizlidir.
                -->
                <Grid DockPanel.Dock="Top" Style="{StaticResource ColumnHeader}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <local:VisualOnlyText Grid.Column="0" Text="Kayıt adı" />
                    <local:VisualOnlyText Grid.Column="1" Text="Tür" />
                    <local:VisualOnlyText Grid.Column="2" Text="Kullanıcı adı" />
                </Grid>
                <ListBox x:Name="EntryList" AutomationProperties.Name="Kayıtlar"
                         AutomationProperties.HelpText="Enter alanlara geçer. Uygulama tuşu işlemler menüsünü açar."
                         SelectionMode="Single" ItemContainerStyle="{StaticResource SpokenItem}"
                         SelectionChanged="EntryList_SelectionChanged" PreviewKeyDown="EntryList_PreviewKeyDown"
                         MouseDoubleClick="EntryList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding KindLabel}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding UserName}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Seçili kaydın alanları -->
            <DockPanel Grid.Row="1" Grid.Column="4">
                <Label x:Name="FieldsLabel" DockPanel.Dock="Top" Content="Ala_nlar:" Target="{Binding ElementName=FieldList}" Padding="0,0,0,3" />
                <Grid DockPanel.Dock="Top" Style="{StaticResource ColumnHeader}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <local:VisualOnlyText Grid.Column="0" Text="Alan" />
                    <local:VisualOnlyText Grid.Column="1" Text="Değer" />
                </Grid>
                <ListBox x:Name="FieldList" AutomationProperties.Name="Alanlar"
                         AutomationProperties.HelpText="Enter seçili alanı kopyalar. Escape kayıt listesine döner."
                         SelectionMode="Single" ItemContainerStyle="{StaticResource SpokenItem}"
                         PreviewKeyDown="FieldList_PreviewKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
