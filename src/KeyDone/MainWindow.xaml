<Window x:Class="KeyDone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyDone" Width="1000" Height="700" MinWidth="560" MinHeight="420"
        FontSize="15" WindowStartupLocation="CenterScreen">
    <!--
        Klavye düzeni:
        - Menü çubuğu Alt ile açılır; tüm işlemler oradadır (sekme sırasında yer almaz).
        - Tab yalnızca dört yerde durur: arama kutusu, tür, kayıt listesi, alan listesi.
        - Ok tuşları yalnızca listelerin ve açılır kutunun içinde çalışır.
        - Ctrl+Tab ya da F6 kayıt listesi ile alan listesi arasında geçer.
    -->
    <DockPanel KeyboardNavigation.DirectionalNavigation="None">
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" FontSize="15" />

        <StatusBar DockPanel.Dock="Bottom" Focusable="False">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Kasa kilitli." />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Arama ve tür süzgeci -->
            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Label Content="A_ra:" Target="{Binding ElementName=SearchBox}" Padding="0,0,0,3" />
                    <TextBox x:Name="SearchBox" AutomationProperties.Name="Ara"
                             AutomationProperties.HelpText="Yazdıkça kayıt listesi süzülür. Aşağı ok listeye geçer."
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Label Content="_Tür:" Target="{Binding ElementName=KindFilter}" Padding="0,0,0,3" />
                    <ComboBox x:Name="KindFilter" AutomationProperties.Name="Tür" SelectionChanged="KindFilter_SelectionChanged" />
                </StackPanel>
            </Grid>

            <!-- Kayıtlar -->
            <DockPanel Grid.Row="1" Grid.Column="0">
                <Label DockPanel.Dock="Top" Content="Kayıt _listesi:" Target="{Binding ElementName=EntryList}" Padding="0,0,0,3" />
                <ListView x:Name="EntryList" AutomationProperties.Name="Kayıtlar"
                          AutomationProperties.HelpText="Enter alanlara geçer. Uygulama tuşu işlemler menüsünü açar."
                          SelectionMode="Single" ItemContainerStyle="{StaticResource SpokenItem}"
                          SelectionChanged="EntryList_SelectionChanged" PreviewKeyDown="EntryList_PreviewKeyDown"
                          MouseDoubleClick="EntryList_MouseDoubleClick">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="Kayıt adı" Width="230" DisplayMemberBinding="{Binding Title}" />
                            <GridViewColumn Header="Tür" Width="140" DisplayMemberBinding="{Binding KindLabel}" />
                            <GridViewColumn Header="Kullanıcı adı" Width="220" DisplayMemberBinding="{Binding UserName}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <!-- Seçili kaydın alanları -->
            <DockPanel Grid.Row="1" Grid.Column="2">
                <Label x:Name="FieldsLabel" DockPanel.Dock="Top" Content="Ala_nlar:" Target="{Binding ElementName=FieldList}" Padding="0,0,0,3" />
                <ListView x:Name="FieldList" AutomationProperties.Name="Alanlar"
                          AutomationProperties.HelpText="Enter seçili alanı kopyalar. Escape kayıt listesine döner."
                          SelectionMode="Single" ItemContainerStyle="{StaticResource SpokenItem}"
                          PreviewKeyDown="FieldList_PreviewKeyDown">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="Alan" Width="170" DisplayMemberBinding="{Binding Label}" />
                            <GridViewColumn Header="Değer" Width="220" DisplayMemberBinding="{Binding Display}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
